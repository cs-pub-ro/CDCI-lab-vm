[Unit]
Description=Final upload of asciinema recordings before shutdown
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target
After=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/pkill -u student asciinema || true
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/bin/asciinema-upload.sh
TimeoutStartSec=30

[Install]
WantedBy=shutdown.target reboot.target halt.target
